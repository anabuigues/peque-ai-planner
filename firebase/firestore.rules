rules_version = '2';

// Ver docs/specs/plataforma.md (tabla de permisos) y docs/specs/privacidad-seguridad.md.
// El servidor usa el Admin SDK (no sujeto a reglas); estas reglas son defensa en profundidad
// para cualquier acceso desde el cliente. Denegado por defecto.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }
    // Perfil propio: lectura desde el cliente; escritura solo desde el servidor (ADR-0014)
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Hogares, peques e invitaciones: solo desde el servidor, que cifra y descifra (ADR-0009, ADR-0014).
    // Ningún cliente —tampoco el admin— accede directamente.
    match /households/{householdId}/{document=**} {
      allow read, write: if false;
    }
    match /households/{householdId} {
      allow read, write: if false;
    }
    match /invites/{inviteId} {
      allow read, write: if false;
    }

    // Catálogo: lectura solo de lo publicado; escritura solo admin
    match /activities/{id} {
      allow read: if (signedIn() && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }
    match /plans/{id} {
      allow read: if (signedIn() && resource.data.status == 'published') || isAdmin();
      allow write: if isAdmin();
    }
    match /cities/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // Operación de datos: exclusivo del administrador (ADR-0007)
    match /sources/{id} { allow read, write: if isAdmin(); }
    match /sourceItems/{id} { allow read, write: if isAdmin(); }
    match /ingestionRuns/{id} { allow read, write: if isAdmin(); }
    match /aiCache/{id} { allow read, write: if isAdmin(); }
    match /generationBatches/{id} { allow read, write: if isAdmin(); }
  }
}
