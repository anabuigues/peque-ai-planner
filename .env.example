# Copia este archivo a .env.local (no se sube a git).

# --- Firebase (local: emuladores, proyecto demo sin cuenta de GCP) ---
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-peque-plan
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-peque-plan.firebaseapp.com
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIRESTORE_EMULATOR_HOST=127.0.0.1:8080
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
GCLOUD_PROJECT=demo-peque-plan

# Emails que reciben el rol admin al iniciar sesión en local (separados por comas)
ADMIN_EMAILS=

# --- IA (ADR-0006 / ADR-0010) ---
# Local: clave de Google AI Studio. Solo con datos públicos del catálogo.
AI_PROVIDER=gemini-api
AI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
# GCP (fase 5): AI_PROVIDER=vertex, GOOGLE_CLOUD_PROJECT=..., GOOGLE_CLOUD_LOCATION=europe-southwest1

# --- Cifrado de campo (ADR-0009) ---
# Local: genera ambas con `npm run setup:keys`. Si se pierden, los datos cifrados del emulador son irrecuperables.
KEY_PROVIDER=local
DATA_KEK=
INVITE_HMAC_KEY=
